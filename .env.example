# Local app configuration
# Vercel disposable demo only: set DEMO_MODE=true and DEMO_DB_PATH=:memory:.
# This uses ephemeral per-instance data; do not use real student information.
NODE_ENV=development
DEMO_MODE=true
DEMO_DB_PATH=./data/learnloop-demo.sqlite

# Supabase cloud mode — LearnLoop project exists, but application repositories and user-session tests are not ready.
# See docs/SUPABASE_SETUP.md; never use a service-role key in these browser-safe variables.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Gemini server-only integration — configure only through a protected secret flow.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
