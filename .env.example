# Local app configuration
NODE_ENV=development
DEMO_MODE=true
DEMO_DB_PATH=./data/learnloop-demo.sqlite

# Supabase cloud mode — leave unset until a dedicated LearnLoop project is available.
# Supabase creation is currently blocked by the selected organization's free-tier project limit.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Gemini server-only integration — configure only through a protected secret flow.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
